#!/bin/sh
# Formats staged C/C++/Lua files before committing.

set -e

# C/C++ files
c_files=$(git diff --cached --name-only --diff-filter=ACM \
    '*.cpp' '*.hpp' '*.c' '*.h' |
    tr '\n' ' ')
if [ -n "$c_files" ]; then
    # shellcheck disable=SC2086
    clang-format -i $c_files
    # shellcheck disable=SC2086
    git add $c_files
fi

# Lua files (via stylua if available)
lua_files=$(git diff --cached --name-only --diff-filter=ACM \
    '*.lua' |
    tr '\n' ' ')
if [ -n "$lua_files" ] && command -v stylua >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    stylua $lua_files
    # shellcheck disable=SC2086
    git add $lua_files
fi
